/**app.wxss**/
page {
  height: 100%;
  color: #1a2530;
  background: #f4f7f6;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.app-shell {
  display: flex;
  flex-direction: column;
  height: 100%;
  background:
    linear-gradient(180deg, rgba(230, 239, 236, 0.9) 0%, rgba(244, 247, 246, 0.95) 36%, #f4f7f6 100%);
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.page-body {
  box-sizing: border-box;
  padding: 24rpx 24rpx 40rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.section-title {
  color: #1a2530;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}

.section-subtitle {
  margin-top: 8rpx;
  color: #7a8890;
  font-size: 24rpx;
  line-height: 1.5;
}

.pill {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #1976d2;
  background: rgba(25, 118, 210, 0.08);
  font-size: 22rpx;
  font-weight: 600;
}

.empty-card {
  padding: 40rpx 28rpx;
  border: 1rpx solid rgba(90, 108, 122, 0.08);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.7);
}

.empty-title {
  color: #1a2530;
  font-size: 28rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 10rpx;
  color: #7a8890;
  font-size: 24rpx;
  line-height: 1.55;
}
